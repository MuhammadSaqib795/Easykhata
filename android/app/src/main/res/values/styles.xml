<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- LIGHT / DEFAULT THEME -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">

        <!-- Flutter splash background -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- Android 12+ splash color (IMPORTANT) -->
        <item name="android:windowSplashScreenBackground">#0F172A</item>

        <!-- No splash icon flicker -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>

        <!-- Remove splash animation delay -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <!-- FIX: removes extra first-frame screen -->
        <item name="android:windowDisablePreview">false</item>

    </style>


    <!-- APP THEME AFTER LOAD -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">

        <!-- After Flutter loads -->
        <item name="android:windowBackground">@drawable/launch_background</item>

    </style>

</resources>